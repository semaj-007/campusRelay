<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.delivery.CreateDeliveryFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_delivery_title"
            android:textColor="@color/relay_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_pickup"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/create_delivery_pickup_label">

            <AutoCompleteTextView
                android:id="@+id/dropdown_pickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_dropoff"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/create_delivery_dropoff_label">

            <AutoCompleteTextView
                android:id="@+id/dropdown_dropoff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_item_description"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/create_delivery_item_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_delivery_item_hint"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/create_delivery_weight_label"
            android:textColor="@color/relay_text_primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_group_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_weight_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/weight_small" />

            <RadioButton
                android:id="@+id/radio_weight_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/weight_medium" />

            <RadioButton
                android:id="@+id/radio_weight_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/weight_large" />
        </RadioGroup>

        <TextView
            android:id="@+id/text_tip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/relay_text_primary"
            android:textStyle="bold"
            tools:text="Incentive tip: R20.00" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="150"
            android:stepSize="5"
            android:value="20" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/create_delivery_submit" />

    </LinearLayout>
</ScrollView>

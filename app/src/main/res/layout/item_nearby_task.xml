<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ic_delivery_box"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/relay_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="PROG7311 Textbook &amp; Notes" />

            <TextView
                android:id="@+id/text_item_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/relay_text_secondary"
                android:textSize="12sp"
                tools:text="Engineering Block B → Merensky Library" />

            <TextView
                android:id="@+id/text_item_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/relay_text_secondary"
                android:textSize="11sp"
                tools:text="0.6 km away" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_item_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/relay_green_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="R35.00 reward" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
